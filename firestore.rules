rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Matches collection
    match /matches/{matchId} {
      // Allow anyone to read matches (for viewing stats)
      allow read: if true;

      // Allow write only from authenticated users
      // For now, restricting writes until Firebase Auth is implemented
      // You can manually add/edit data through Firebase Console
      allow write: if request.auth != null;
    }

    // Metadata collection
    match /metadata/{metadataId} {
      // Allow anyone to read metadata
      allow read: if true;

      // Allow write only from authenticated users
      allow write: if request.auth != null;
    }

    // Mercato collection
    match /mercato/{mercatoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Config collection (saisons, settings, admin roles)
    // "saisons" et "adminRoles" sont réservés aux admins avec le rôle "full" —
    // un admin avec le rôle "matches" (édition de matchs uniquement) ne peut
    // pas y écrire, même en contournant l'UI (ex: console navigateur).
    // adminRoles contient les emails des admins : lisible uniquement par un
    // admin qui y figure (l'onglet Admin le lit pour connaître son rôle),
    // plus par le public. Les autres documents (saisons) restent publics,
    // l'app les lit sans connexion.
    match /config/{configId} {
      allow read: if configId != 'adminRoles' || (
        request.auth != null &&
        request.auth.token.email.lower() in resource.data
      );
      allow write: if request.auth != null && (
        !(configId in ['saisons', 'adminRoles']) ||
        get(/databases/$(database)/documents/config/adminRoles).data[request.auth.token.email.lower()] == 'full'
      );
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
