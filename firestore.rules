rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Matches collection
    match /matches/{matchId} {
      // Allow anyone to read matches (for viewing stats)
      allow read: if true;

      // Allow write only from authenticated users
      // For now, restricting writes until Firebase Auth is implemented
      // You can manually add/edit data through Firebase Console
      allow write: if request.auth != null;
    }

    // Metadata collection
    match /metadata/{metadataId} {
      // Allow anyone to read metadata
      allow read: if true;

      // Allow write only from authenticated users
      allow write: if request.auth != null;
    }

    // Post-its collection (collaborative notes)
    match /postits/{postItId} {
      // Allow anyone to read and write post-its
      // This is a collaborative feature accessible to all users
      allow read: if true;
      allow create: if true;
      allow delete: if true;
      allow update: if true;
    }

    // Mercato collection
    match /mercato/{mercatoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
